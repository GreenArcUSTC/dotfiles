# Terminal color compatibility: prefer readable output over automatic guessing.
# Use a dark background everywhere; this matches the safest default assumed by
# most terminal TUIs over SSH/tmux.
export COLORTERM=truecolor
export HERMES_TUI_THEME=dark
export HERMES_TUI_BACKGROUND="#000000"
export BAT_THEME=ansi
export CLICOLOR=1
