export EDITOR=vim

# Homebrew：Apple Silicon 在 /opt/homebrew，Intel 在 /usr/local
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
done
unset _brew

# export JAVA_HOME=$(/usr/libexec/java_home)

# export TVM_HOME="$HOME/Workspace/tvm"

# 只把真实存在的目录加进 PATH
_prepend_path() { [ -d "$1" ] && export PATH="$1:$PATH" }
_append_path()  { [ -d "$1" ] && export PATH="$PATH:$1" }

_prepend_path "$(brew --prefix 2>/dev/null)/opt/llvm@13/bin"

# pyenv disabled (migrated to uv on 2026-03-04)
