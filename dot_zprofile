# eval "$(pyenv init -)"
# eval "$(pyenv virtualenv-init -)"

# remove duplicat entries from $PATH
# zsh uses $path array along with $PATH
typeset -U PATH path

# add cargo path to $PATH
_prepend_path "$HOME/.cargo/bin"

# Adds `~/.local/bin` to $PATH
_prepend_path "$HOME/.local/bin"

