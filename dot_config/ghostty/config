# 固定 Solarized Light，不跟随 macOS 深浅色切换（对齐 iTerm2 Profile 基线）
theme = solarized-light

# 主字体：JetBrains Mono（编程连字，终端显示清晰）
font-family = "JetBrains Mono"

# 中文回退字体：MiSans（主字体缺少的中文字形自动用它渲染）
font-family = "MiSans"

# 字体大小，按你眼睛舒服改
font-size = 14

# 保持默认 TERM=xterm-ghostty，但 SSH 时自动兼容远程机器
shell-integration = detect
shell-integration-features = ssh-env,ssh-terminfo,path

# tmux/ssh 更稳，不恢复一堆旧窗口
window-save-state = never

# 右键更接近普通 App 习惯
right-click-action = context-menu

# config for pi agent
keybind = alt+backspace=text:\x1b\x7f

# === 以下仿照 iTerm2 Profile 基线 ===

# 滚动缓冲：iTerm2 为 10,000 行；Ghostty 按字节计，2MB 约等效
scrollback-limit = 2000000

# 左 Option 发送 Esc+（Alt/Meta），右 Option 保留 macOS 特殊字符输入
macos-option-as-alt = left

# 光标：竖线、不闪烁（对齐 iTerm2 默认）
cursor-style = bar
cursor-style-blink = false

# 关闭终端前弹出确认（对齐 iTerm2"有任务运行时询问"）
confirm-close-surface = true

# 窗口标题栏固定浅色，配合固定浅色主题
window-theme = light
