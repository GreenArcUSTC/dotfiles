[alias]
  co = checkout
  ci = commit
  br = branch
  st = status
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[user]
	name = LI Wei
{{- if hasKey . "email" }}
	email = {{ .email }}
{{- else }}
	# Email 不入公开仓库：在 ~/.config/chezmoi/chezmoi.toml 的 [data] 里设 email，
	# 或直接 `git config --global user.email`。
{{- end }}
{{- if hasKey . "gitIncludes" }}
{{- range .gitIncludes }}
[includeIf "gitdir:{{ .gitdir }}"]
    path = {{ .path }}
{{- end }}
{{- end }}
[init]
  defaultBranch = main
[core]
	editor = vim
	pager = less -x1,5
	autocrlf = input
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = true
[push]
	default = simple
[pull]
	ff = only
[merge]
	ff = only
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
