-- ============================================================
--  输入法自动切换
--  规则：列表内的 App → 微信输入法；其余 App → 英文 ABC
-- ============================================================

-- 【第一步】确认输入法 ID
-- 切换到对应输入法后，在 Hammerspoon Console 执行以下命令查询：
--   hs.keycodes.currentSourceID()

local IM_CHINESE = "com.tencent.inputmethod.wetype.pinyin"  -- 微信输入法
-- local IM_CHINESE = "com.bytedance.inputmethod.doubaoime.pinyin"  -- 豆包输入法
local IM_ENGLISH = "com.apple.keylayout.ABC"            -- 系统英文 ABC

-- 【第二步】填写需要中文输入法的 App
-- 这份清单等于「我装了哪些软件」，所以不放进公开仓库，而是放在
-- ~/.config/chezmoi/chezmoi.toml 的 [[data.chineseApps]] 里（见 README）。
-- 查询 Bundle ID：切换到目标 App，在 Hammerspoon Console 执行：
--   hs.application.frontmostApplication():bundleID()
-- 改完执行 chezmoi apply，再在菜单栏 Reload Config。
local chineseApps = {
{{- if hasKey . "chineseApps" }}
{{- range .chineseApps }}
    "{{ .id }}",{{ if .comment }}  -- {{ .comment }}{{ end }}
{{- end }}
{{- else }}
    -- 未配置本地数据时的默认清单，只含系统自带 App
    "com.apple.Notes",          -- 备忘录
    "com.apple.mail",           -- 邮件
{{- end }}
}

-- ============================================================
--  以下无需修改
-- ============================================================

local chineseAppSet = {}
for _, id in ipairs(chineseApps) do
    chineseAppSet[id] = true
end

-- 切换提示：屏幕右上角的半透明小胶囊，短暂显示，不打断操作
-- （hs.alert 只支持居中/顶/底，右上角需用 hs.canvas 自绘）
local hintCanvas = nil
local hintTimer = nil

local function showHint(text)
    if hintTimer then hintTimer:stop(); hintTimer = nil end
    if hintCanvas then hintCanvas:delete(); hintCanvas = nil end

    local screenFrame = hs.screen.mainScreen():frame()
    local w, h = 44, 26
    hintCanvas = hs.canvas.new({
        x = screenFrame.x + screenFrame.w - w - 12,
        y = screenFrame.y + 12,
        w = w,
        h = h,
    })
    hintCanvas[1] = {
        type = "rectangle",
        action = "fill",
        fillColor = { white = 0, alpha = 0.55 },
        roundedRectRadii = { xRadius = h / 2, yRadius = h / 2 },
    }
    hintCanvas[2] = {
        type = "text",
        text = text,
        textSize = 13,
        textColor = { white = 1, alpha = 0.85 },
        textAlignment = "center",
        frame = { x = 0, y = (h - 18) / 2, w = w, h = 18 },
    }
    hintCanvas:level(hs.canvas.windowLevels.overlay)
    hintCanvas:show()
    hintTimer = hs.timer.doAfter(0.6, function()
        if hintCanvas then hintCanvas:delete(0.2); hintCanvas = nil end
        hintTimer = nil
    end)
end

local function switchInput(bundleID)
    local target = chineseAppSet[bundleID] and IM_CHINESE or IM_ENGLISH
    if hs.keycodes.currentSourceID() ~= target then
        hs.keycodes.currentSourceID(target)
        showHint(target == IM_CHINESE and "中" or "EN")
    end
end

local windowFilter = hs.window.filter.new(nil, "inputSwitcher")
windowFilter:subscribe(hs.window.filter.windowFocused, function(win)
    if not win then return end
    local app = win:application()
    if not app then return end
    local bid = app:bundleID()
    if not bid then return end
    -- 延时 0.1s 再切换，避免被系统/App 自身的输入法行为覆盖；
    -- 触发时校验前台 App 未变，防止快速连续切窗口时按过期 bundleID 切换
    hs.timer.doAfter(0.1, function()
        local front = hs.application.frontmostApplication()
        if front and front:bundleID() == bid then switchInput(bid) end
    end)
end)

local front = hs.application.frontmostApplication()
if front then switchInput(front:bundleID()) end

hs.alert.show("⌨️ 输入法自动切换已启动")
