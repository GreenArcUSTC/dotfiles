[alias]
  co = checkout
  ci = commit
  br = branch
  st = status
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[user]
	name = LI Wei
	# Email is intentionally omitted from this public dotfiles repo.
	# Set it locally in ~/.gitconfig.local or via `git config --global user.email`.

[init]
  defaultBranch = main
[core]
	editor = vim
	pager = less -x1,5
	autocrlf = input
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = true
[push]
	default = simple
[pull]
	ff = only
[merge]
	ff = only
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
